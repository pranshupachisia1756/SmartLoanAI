# SmartLoanAI Environment Configuration (Example)
# Copy this file to .env and adjust variables as required.

# Database URL (defaults to SQLite in the project root)
SMARTLOAN_DATABASE_URL=sqlite:///./smartloan.db

# JWT Authentication Secret Key (replace with a long random key in production)
SMARTLOAN_JWT_SECRET=smartloan-ai-college-secret-key-2026-secure

# JWT Algorithm and Expiration
SMARTLOAN_JWT_ALGORITHM=HS256
SMARTLOAN_JWT_EXPIRATION_MINUTES=1440

# Maximum Document Upload Size (10 MB in bytes)
SMARTLOAN_MAX_UPLOAD_BYTES=10485760

# Demo Mode Settings (Enables pre-filled OTP for smooth student testing)
SMARTLOAN_DEMO_OTP_ENABLED=true

# Bank Admin Demo Password (used to seed initial bank officer account)
SMARTLOAN_BANK_DEMO_PASSWORD=bank-demo123
